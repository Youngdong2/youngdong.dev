---
import Base from '../layouts/Base.astro';
import { getPosts, groupByYear } from '../lib/posts';
import { KINDS } from '../consts';

const posts = await getPosts();
const years = groupByYear(posts);
---
<Base current="posts">
  <section class="intro">
    <p>AI 에이전트를 만드는 엔지니어 김영동입니다.<br />일하면서 겪은 문제와 읽고 생각한 것을 적습니다.</p>
  </section>

  <div class="filter" role="toolbar" aria-label="글 종류">
    <button type="button" aria-pressed="true" data-k="all">전체</button>
    {Object.entries(KINDS).map(([k, label]) => (
      <button type="button" aria-pressed="false" data-k={k}>{label}</button>
    ))}
  </div>

  <section class="archive" aria-label="글 목록">
    {posts.length === 0 && <p class="empty">아직 글이 없어요. 첫 글을 준비하고 있습니다.</p>}
    {years.map(([year, list]) => (
      <div class="year">
        <h2>{year}</h2>
        <div>
          {list.map((p) => (
            <article class={`post-row ${p.data.kind}`} data-k={p.data.kind}>
              <time datetime={p.data.date.toISOString()}>{p.data.date.getMonth() + 1}월</time>
              <a href={`/posts/${p.id}/`}>
                <h3>{p.data.title}{p.data.draft && <span class="draft-tag">초안</span>}</h3>
                {p.data.kind !== 'memo' && p.data.description && <p>{p.data.description}</p>}
              </a>
              <span class="kind">{KINDS[p.data.kind]}</span>
            </article>
          ))}
        </div>
      </div>
    ))}
  </section>
</Base>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter button');
  buttons.forEach((b) =>
    b.addEventListener('click', () => {
      const k = b.dataset.k;
      buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      document.querySelectorAll<HTMLElement>('.post-row').forEach((row) => {
        row.hidden = !(k === 'all' || row.dataset.k === k);
      });
      document.querySelectorAll<HTMLElement>('.year').forEach((y) => {
        y.hidden = ![...y.querySelectorAll<HTMLElement>('.post-row')].some((r) => !r.hidden);
      });
    }),
  );
</script>
