---
import { SITE } from '../consts';
const g = SITE.giscus;
// repoId·categoryId는 https://giscus.app 에서 저장소를 고르면 나온다. 비어 있으면 댓글을 그리지 않는다
const ready = Boolean(g.repo && g.repoId && g.categoryId);
---
{ready && (
  <section class="comments" aria-label="댓글">
    <div class="giscus-slot"
      data-repo={g.repo} data-repo-id={g.repoId}
      data-category={g.category} data-category-id={g.categoryId}></div>
  </section>
)}

<script>
  const slot = document.querySelector<HTMLElement>('.giscus-slot');
  const isDark = () => {
    const t = document.documentElement.dataset.theme;
    return t ? t === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
  };
  const theme = () => (isDark() ? 'dark' : 'light');

  if (slot) {
    // 화면에 가까워졌을 때만 불러온다 (글을 끝까지 안 읽는 사람에게는 비용 없음)
    const io = new IntersectionObserver((es) => {
      if (!es[0].isIntersecting) return;
      io.disconnect();
      const s = document.createElement('script');
      s.src = 'https://giscus.app/client.js';
      s.async = true;
      s.crossOrigin = 'anonymous';
      const attrs: Record<string, string> = {
        'data-repo': slot.dataset.repo!, 'data-repo-id': slot.dataset.repoId!,
        'data-category': slot.dataset.category!, 'data-category-id': slot.dataset.categoryId!,
        'data-mapping': 'pathname', 'data-strict': '1', 'data-reactions-enabled': '1',
        'data-emit-metadata': '0', 'data-input-position': 'top', 'data-lang': 'ko',
        'data-loading': 'lazy', 'data-theme': theme(),
      };
      Object.entries(attrs).forEach(([k, v]) => s.setAttribute(k, v));
      slot.append(s);
    }, { rootMargin: '600px' });
    io.observe(slot);

    // 사이트 다크 모드 버튼을 누르면 댓글 테마도 맞춘다
    new MutationObserver(() => {
      document.querySelector<HTMLIFrameElement>('iframe.giscus-frame')?.contentWindow
        ?.postMessage({ giscus: { setConfig: { theme: theme() } } }, 'https://giscus.app');
    }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
  }
</script>
