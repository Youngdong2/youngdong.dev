---
import '../styles/global.css';
import { SITE } from '../consts';

interface Props {
  title?: string;
  description?: string;
  current?: 'posts' | 'about' | null;
  type?: 'website' | 'article';
}
const { title, description = SITE.description, current = null, type = 'website' } = Astro.props;
const pageTitle = title ? `${title} | ${SITE.title}` : `${SITE.title} | youngdong.dev`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title ?? SITE.title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="ko_KR" />
    <meta name="twitter:card" content="summary" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+KR:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="skip" href="#main">본문으로 건너뛰기</a>
    <div class="wrap">
      <header class="site-top">
        <a class="site-name" href="/">{SITE.title}</a>
        <nav aria-label="주 메뉴">
          <a href="/" aria-current={current === 'posts' ? 'page' : undefined}>글</a>
          <a href="/about" aria-current={current === 'about' ? 'page' : undefined}>소개</a>
          <a href="/rss.xml">RSS</a>
        </nav>
      </header>
      <main id="main"><slot /></main>
      <footer class="site-foot">
        <span>youngdong.dev</span>
        {SITE.links.github && <a href={SITE.links.github}>GitHub</a>}
        {SITE.links.linkedin && <a href={SITE.links.linkedin}>LinkedIn</a>}
        <a href="/rss.xml">RSS</a>
      </footer>
    </div>
  </body>
</html>
